                    .from('itens')
                    .update({ estoque: novoEstoque })
                    .eq('codigo', produto.codigo)
                    .eq('loja_id', lojaAtual.id);

                if (updateError) throw updateError;

                console.log('✅ Estoque atualizado no banco');

                // 2. Registrar movimentação
