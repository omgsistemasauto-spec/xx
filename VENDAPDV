        // ==================== FINALIZAR VENDA DINHEIRO ====================
        async function finalizarVendaDinheiro() {
            // ✅ VERIFICAR SE CAIXA ESTÁ ABERTO
            if (!caixaAtual || caixaAtual.status !== 'ABERTO') {
                alert('❌ CAIXA FECHADO!\n\nVocê precisa abrir o caixa antes de realizar vendas.');
                return;
            }

            if (carrinho.length === 0) {
                alert('Carrinho vazio! Adicione produtos primeiro.');
                return;
            }

            const valorTotal = parseFloat(getValorTotal());
            
            console.log('Iniciando pagamento em DINHEIRO...');
            
            // Pedir valor recebido
            const valorRecebidoStr = prompt(`💵 PAGAMENTO EM DINHEIRO\n\nValor da compra: R$ ${valorTotal.toFixed(2)}\n\nDigite o valor recebido:`);
            
            if (valorRecebidoStr === null) return; // Cancelou
            
            const valorRecebido = parseFloat(valorRecebidoStr.replace(',', '.'));
            
            if (isNaN(valorRecebido) || valorRecebido < valorTotal) {
                alert('❌ Valor inválido ou insuficiente!');
                return;
            }
            
            const troco = valorRecebido - valorTotal;
            
            try {
                // 1. TENTAR ABRIR GAVETA DE DINHEIRO
