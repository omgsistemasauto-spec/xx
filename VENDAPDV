        function fecharPagamentoDividido() {
            document.getElementById('modalDividido').classList.remove('active');
            parcelasDivididas = [];
            contadorParcelas = 0;
        }

        function adicionarParcela() {
            contadorParcelas++;
            const id = contadorParcelas;
            
            parcelasDivididas.push({
                id: id,
                metodo: 'DINHEIRO',
                valor: 0
            });

            renderizarParcelas();
        }

        function removerParcela(id) {
            parcelasDivididas = parcelasDivididas.filter(p => p.id !== id);
            renderizarParcelas();
        }

        function atualizarParcela(id, campo, valor) {
            const parcela = parcelasDivididas.find(p => p.id === id);
            if (parcela) {
                parcela[campo] = valor;
                calcularResumo();
            }
        }

        function renderizarParcelas() {
            const lista = document.getElementById('listaPagamentos');
            
            if (parcelasDivididas.length === 0) {
                lista.innerHTML = '<p style="text-align: center; color: #6b7280; padding: 20px;">Nenhuma forma de pagamento adicionada</p>';
                return;
            }

            let html = '';
            
            parcelasDivididas.forEach((parcela, index) => {
                html += `
                    <div class="pagamento-item">
                        <div class="pagamento-item-header">
                            <span class="pagamento-numero">Pagamento ${index + 1}</span>
                            ${parcelasDivididas.length > 1 ? `<button class="btn-remover-pagamento" onclick="removerParcela(${parcela.id})">🗑️ Remover</button>` : ''}
                        </div>
                        <div class="form-row">
                            <div>
                                <label class="form-label">Forma de Pagamento:</label>
                                <select class="form-select" onchange="atualizarParcela(${parcela.id}, 'metodo', this.value)">
                                    <option value="DINHEIRO" ${parcela.metodo === 'DINHEIRO' ? 'selected' : ''}>💵 Dinheiro</option>
                                    <option value="PIX" ${parcela.metodo === 'PIX' ? 'selected' : ''}>📱 PIX</option>
                                    <option value="DEBITO" ${parcela.metodo === 'DEBITO' ? 'selected' : ''}>💳 Débito</option>
                                    <option value="CREDITO" ${parcela.metodo === 'CREDITO' ? 'selected' : ''}>💳 Crédito</option>
                                </select>
                            </div>
                            <div>
                                <label class="form-label">Valor (R$):</label>
                                <input 
                                    type="number" 
                                    class="form-input" 
                                    step="0.01" 
                                    min="0" 
                                    value="${parcela.valor}"
                                    onchange="atualizarParcela(${parcela.id}, 'valor', parseFloat(this.value) || 0)"
                                    placeholder="0,00"
                                >
                            </div>
                        </div>
                    </div>
                `;
            });

            lista.innerHTML = html;
            calcularResumo();
        }

        function calcularResumo() {
            const valorTotal = parseFloat(getValorTotal());
            const valorPago = parcelasDivididas.reduce((sum, p) => sum + (parseFloat(p.valor) || 0), 0);
            const faltante = valorTotal - valorPago;

            document.getElementById('resumoPago').textContent = valorPago.toFixed(2).replace('.', ',');
            
            const faltanteEl = document.getElementById('resumoFaltante');
            faltanteEl.textContent = 'R$ ' + Math.abs(faltante).toFixed(2).replace('.', ',');
            
            if (faltante > 0.01) {
                faltanteEl.className = 'valor-faltante';
            } else if (faltante < -0.01) {
                faltanteEl.className = 'valor-faltante';
                faltanteEl.textContent = 'R$ ' + Math.abs(faltante).toFixed(2).replace('.', ',') + ' (EXCEDENTE)';
            } else {
                faltanteEl.className = 'valor-ok';
                faltanteEl.textContent = '✅ PAGO COMPLETO';
            }
        }

        async function finalizarPagamentoDividido() {
            const valorTotal = parseFloat(getValorTotal());
            const valorPago = parcelasDivididas.reduce((sum, p) => sum + (parseFloat(p.valor) || 0), 0);
            const diferenca = Math.abs(valorTotal - valorPago);

