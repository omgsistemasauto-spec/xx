        // Abrir caixa
        async function abrirCaixa() {
            const valorInicial = prompt('Digite o valor inicial em caixa (R$):\n\nExemplo: 100.00');
            
            if (valorInicial === null) return; // Cancelou

            const valor = parseFloat(valorInicial.replace(',', '.'));
            
            if (isNaN(valor) || valor < 0) {
                alert('❌ Valor inválido! Digite um número positivo.');
                return;
            }

            const observacao = prompt('Observação (opcional):') || '';

            try {
                console.log('Abrindo caixa com valor inicial:', valor);

                // REGISTRAR ABERTURA NO BANCO
                const { data, error } = await supabaseClient
                    .from('caixas')
                    .insert([{
                        usuario_abertura: usuarioAtual.id,
                        valor_inicial: valor,
                        observacao_abertura: observacao,
                        status: 'ABERTO'
                    }])
                    .select()
                    .single();

                if (error) throw error;

                caixaAtual = data;
                console.log('✅ Caixa aberto:', data.id);
                
                atualizarBotaoCaixa(true);
                
                // ENVIAR NOTIFICAÇÃO TELEGRAM
                await notificarAcaoCaixa('ABRIR', {
                    valorInicial: valor,
                    observacao: observacao
                });
                
                alert(`✅ Caixa aberto com sucesso!\n\n💰 Gaveta aberta\nValor inicial: R$ ${valor.toFixed(2)}`);
            } catch (error) {
                console.error('Erro ao abrir caixa:', error);
                alert('❌ Erro ao abrir caixa: ' + error.message);
            }
        }

        // Fechar caixa
        async function fecharCaixa() {
            if (!caixaAtual) {
                alert('Nenhum caixa aberto');
                return;
            }

            // Calcular totais do caixa
            const { data: vendas, error: vendasError } = await supabaseClient
                .from('vendas')
                .select('valor_total, metodo_pagamento')
                .eq('loja_id', lojaAtual.id)
                .gte('data_venda', caixaAtual.data_abertura)
                .eq('status', 'CONCLUIDA');

            if (vendasError) {
                console.error('Erro ao buscar vendas:', vendasError);
                alert('Erro ao calcular vendas do caixa');
                return;
            }

            // Buscar retiradas do caixa
            const { data: retiradas, error: retiradasError } = await supabaseClient
                .from('retiradas_caixa')
                .select('valor')
                .eq('caixa_id', caixaAtual.id);

            const totalRetiradas = retiradas ? retiradas.reduce((sum, r) => sum + parseFloat(r.valor), 0) : 0;

            // Calcular totais por método
            let totalGeral = 0;
            let totalPix = 0;
            let totalCredito = 0;
            let totalDebito = 0;
            let totalDinheiro = 0;
            let qtdVendas = vendas.length;

            vendas.forEach(venda => {
                const valor = parseFloat(venda.valor_total);
                totalGeral += valor;

                switch(venda.metodo_pagamento) {
                    case 'PIX': totalPix += valor; break;
                    case 'CREDITO': totalCredito += valor; break;
                    case 'DEBITO': totalDebito += valor; break;
                    case 'DINHEIRO': totalDinheiro += valor; break;
                }
            });

            const valorEsperado = parseFloat(caixaAtual.valor_inicial) + totalDinheiro - totalRetiradas;

            const mensagem = `
📊 RESUMO DO CAIXA

💰 Valor Inicial: R$ ${parseFloat(caixaAtual.valor_inicial).toFixed(2)}

📦 Vendas Realizadas: ${qtdVendas}
💳 Total Vendas: R$ ${totalGeral.toFixed(2)}

Detalhamento por método:
• PIX: R$ ${totalPix.toFixed(2)}
• Crédito: R$ ${totalCredito.toFixed(2)}
• Débito: R$ ${totalDebito.toFixed(2)}
• Dinheiro: R$ ${totalDinheiro.toFixed(2)}

💸 Retiradas: R$ ${totalRetiradas.toFixed(2)}

💵 Valor Esperado em Caixa: R$ ${valorEsperado.toFixed(2)}

Digite o valor REAL contado no caixa:`;

            const valorContado = prompt(mensagem);
            
            if (valorContado === null) return; // Cancelou

            const valorFinal = parseFloat(valorContado.replace(',', '.'));
            
            if (isNaN(valorFinal) || valorFinal < 0) {
                alert('❌ Valor inválido!');
                return;
            }

            const diferenca = valorFinal - valorEsperado;
            const observacaoFinal = prompt('Observação do fechamento (opcional):') || '';

            try {
                const { error } = await supabaseClient
                    .from('caixas')
                    .update({
                        status: 'FECHADO',
                        data_fechamento: new Date().toISOString(),
                        usuario_fechamento: usuarioAtual.id,
                        valor_vendas: totalGeral,
                        valor_final: valorFinal,
                        total_vendas_pix: totalPix,
                        total_vendas_credito: totalCredito,
                        total_vendas_debito: totalDebito,
                        total_vendas_dinheiro: totalDinheiro,
                        qtd_vendas: qtdVendas,
                        observacao_fechamento: observacaoFinal
                    })
                    .eq('id', caixaAtual.id);

                if (error) throw error;

                let mensagemFinal = `✅ CAIXA FECHADO COM SUCESSO!\n\n`;
                mensagemFinal += `💰 Valor Esperado: R$ ${valorEsperado.toFixed(2)}\n`;
                mensagemFinal += `💵 Valor Contado: R$ ${valorFinal.toFixed(2)}\n\n`;
                
                if (diferenca > 0) {
                    mensagemFinal += `📈 Sobra: R$ ${diferenca.toFixed(2)}`;
                } else if (diferenca < 0) {
                    mensagemFinal += `📉 Falta: R$ ${Math.abs(diferenca).toFixed(2)}`;
                } else {
                    mensagemFinal += `✅ Caixa bateu certinho!`;
                }

                console.log('✅ Venda cancelada:', vendaId);

                alert(mensagemFinal);
                
                // Enviar notificação Telegram
                await notificarAcaoCaixa('FECHAR', {
                    valorInicial: parseFloat(caixaAtual.valor_inicial),
                    valorFinal: valorFinal,
                    valorVendas: totalGeral,
                    qtdVendas: qtdVendas,
                    totalRetiradas: totalRetiradas,
                    diferenca: diferenca
                });
                
                caixaAtual = null;
                atualizarBotaoCaixa(false);
            } catch (error) {
                console.error('Erro ao fechar caixa:', error);
                alert('❌ Erro ao fechar caixa: ' + error.message);
            }
        }

