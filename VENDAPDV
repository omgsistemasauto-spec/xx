            console.log('Renderizando categorias com', produtos.length, 'produtos');
            const categorias = ['Sorvetes', 'Bebidas', 'Salgados', 'Combos', 'Outros'];
            const grid = document.getElementById('categoriasGrid');

            if (produtos.length === 0) {
                grid.innerHTML = `
                    <div class="carrinho-empty">
                        <div class="carrinho-empty-icon">📦</div>
                        <p>Nenhum produto cadastrado</p>
                    </div>
                `;
                return;
            }

            let html = '';

            categorias.forEach(categoria => {
                let produtosCategoria;
                
                if (categoria === 'Sorvetes') {
                    // Produtos que começam com "X" são sorvetes
                    produtosCategoria = produtos.filter(p => p.codigo.toUpperCase().startsWith('X'));
                } else {
                    // Demais produtos vão para suas categorias normais (exceto os que começam com X)
                    produtosCategoria = produtos.filter(p => 
                        p.categoria === categoria && !p.codigo.toUpperCase().startsWith('X')
                    );
                }
                
                if (produtosCategoria.length === 0) return;

                const corClasse = categoria.toLowerCase();
                
                html += `
                    <div class="categoria-card">
                        <div class="categoria-header ${corClasse}">${categoria.toUpperCase()}</div>
                        <div class="categoria-produtos">
